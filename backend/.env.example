# Optional. If set, narratives are enhanced by a real LLM call (Anthropic Claude).
# If left blank, Clarity runs fully offline in deterministic "template mode" —
# the entire demo works with zero external dependencies or cost.
ANTHROPIC_API_KEY=

# Model used only when ANTHROPIC_API_KEY is set.
ANTHROPIC_MODEL=claude-sonnet-4-5

# SQLite file used for the persistent audit log (auto-created on first run).
DATABASE_URL=sqlite:///./clarity_audit.db

# CORS origin for the Vite dev server.
FRONTEND_ORIGIN=http://localhost:5173

# Optional production data connectors. The demo remains on seeded data when blank.
WAREHOUSE_DATABASE_URL=
BI_API_URL=
BI_API_TOKEN=
